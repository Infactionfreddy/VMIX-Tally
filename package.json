{
  "name": "vmix-atem-tally-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "vMix → ATEM tally bridge: reads vMix live/preview tally and drives ATEM program/preview bus for SDI camera tally distribution.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node node_modules/.bin/tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "svelte": "^5.56.4",
    "typescript": "^5",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "atem-connection": "^3.9.0",
    "fastify": "^5.9.0",
    "lowdb": "^7.0.1",
    "pino": "^10.3.1",
    "tsx": "^4.22.5",
    "zod": "^4.4.3"
  }
}
